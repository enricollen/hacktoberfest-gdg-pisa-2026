# Copy to backend/.env and fill in. The ElevenLabs key lives in ../.env.local
# (created by `npx -y @elevenlabs/cli@latest onboard init`).
GOOGLE_API_KEY=
# Optional: used automatically when the main key runs out of quota (HTTP 429)
GOOGLE_API_KEY_FALLBACK=

