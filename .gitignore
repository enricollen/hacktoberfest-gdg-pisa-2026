# Local secrets written by `elevenlabs onboard`
/.env.local

# Local secrets (any env file, in any folder)
.env
.env.*
!.env.example
!**/.env.example

# Playwright MCP output (screenshots, traces)
/.playwright-mcp/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Backend runtime data (regenerated by `scripts.seed_catalog` and at runtime)
/backend/data/*.sqlite*
/backend/data/uploads/
/backend/data/media/
# Model weights: only the exported ONNX detector is versioned; CLIP is downloaded by fastembed
/backend/models/*
!/backend/models/yoloe-26s-seg-pf.onnx

# Node
node_modules/
dist/
dev-dist/
/backend/logs/
